{
  "name": "flowkit-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "rspress dev",
    "preview": "rspress preview",
    "build": "rspress build && node scripts/check-rendered.mjs",
    "check": "tsc --noEmit && node scripts/check-content.mjs && node --test scripts/checks.test.mjs ../scripts/docs/*.test.mjs"
  },
  "dependencies": {
    "@rspress/core": "2.0.23",
    "@rspress/plugin-sitemap": "2.0.23",
    "mermaid": "12.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "parse5": "7.3.0"
  }
}
