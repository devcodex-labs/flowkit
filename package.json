{
  "name": "@devcodex/flowkit",
  "version": "0.0.0-m0",
  "private": true,
  "description": "Compile declarative workflows into readable JavaScript and execute them with a host Runtime",
  "repository": { "type": "git", "url": "git+https://github.com/devcodex-labs/flowkit.git" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "bin": { "flowkit": "./dist/cli.mjs" },
  "exports": {
    ".": { "types": "./dist/compiler-api.d.ts", "import": "./dist/index.mjs", "default": "./dist/index.mjs" },
    "./dsl": { "types": "./dist/dsl.d.ts", "import": "./dist/dsl.mjs", "default": "./dist/dsl.mjs" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/dsl.test.mjs tests/contracts.test.mjs tests/compiler/*.test.mjs tests/when/*.test.mjs tests/runtime/*.test.mjs tests/cli/*.test.mjs tests/package/*.test.mjs",
    "test:types": "node scripts/test-types.mjs",
    "check:package": "node scripts/check-package.mjs",
    "test:package": "node scripts/test-package.mjs",
    "release:check": "node scripts/release.mjs check",
    "release:pack": "node scripts/release.mjs pack",
    "update:goldens": "node scripts/update-goldens.mjs",
    "verify": "npm run build && npm test && npm run test:types && npm run check:package && npm run test:package"
  },
  "dependencies": { "acorn": "8.19.0" },
  "devDependencies": { "typescript": "5.0.4", "tar": "7.5.22" }
}
